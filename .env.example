# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TEACHER_ACCESS_CODE: Required secret for Teacher Aide, Progress, Alerts, and Acknowledge routes.
# Configure this in the Secrets panel (server-side only, never prefixed with VITE_).
TEACHER_ACCESS_CODE="MY_TEACHER_ACCESS_CODE"

# SESSION_HMAC_SECRET: Optional HMAC key for signing chat session IDs (auto-generated per boot if omitted).
SESSION_HMAC_SECRET="MY_SESSION_HMAC_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
